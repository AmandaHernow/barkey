<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/keyboard_surface_disabled" />
            <stroke android:width="1dp" android:color="@color/keyboard_outline_disabled" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/keyboard_surface_pressed" />
            <stroke android:width="1dp" android:color="@color/keyboard_outline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/keyboard_surface" />
            <stroke android:width="1dp" android:color="?android:attr/colorAccent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/keyboard_surface" />
            <stroke android:width="1dp" android:color="@color/keyboard_outline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
